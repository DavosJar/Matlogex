package grammar;

import java_cup.runtime.*;
import grammar.node.*;

/*
 * parser.cup - Analizador sintáctico LALR para fórmulas lógicas.
 * GLC no ambigua con precedencia: NOT > AND > OR
 *
 * Reglas de producción (Tabla 7 del documento):
 *   Exp    → Exp OR Term | Term
 *   Term   → Term AND Factor | Factor
 *   Factor → NOT Factor | ( Exp ) | VARIABLE
 */

parser code {:
    private Lexer lexer;

    /**
     * Constructor que recibe el lexer ya instanciado.
     *
     * @param lexer Instancia del analizador léxico
     */
    public parser(Lexer lexer) {
        this();
        this.lexer = lexer;
    }

    /**
     * Reporta un error sintáctico con la posición del token problemático.
     *
     * @param message Mensaje de error
     * @param info    Token que causó el error
     */
    @Override
    public void report_error(String message, Object info) {
        if (info instanceof Symbol) {
            Symbol s = (Symbol) info;
            System.err.println("Error sintáctico en posición " + s.left
                + ": token '" + s.value + "'");
        } else {
            System.err.println("Error sintáctico: " + message);
        }
    }
:};

scan with {: return lexer.next_token(); :};

/* ── Terminales ── */
terminal            AND, OR, NOT, LPAREN, RPAREN;
terminal String     VARIABLE;

/* ── No terminales ── */
nonterminal Node    Exp, Term, Factor;

/* ── Gramática (precedencia implícita por estructura) ── */
start with Exp;

Exp ::=
    Exp:left OR Term:right
    {: RESULT = new BinaryNode("OR", left, right); :}
    |
    Term:t
    {: RESULT = t; :}
    ;

Term ::=
    Term:left AND Factor:right
    {: RESULT = new BinaryNode("AND", left, right); :}
    |
    Factor:f
    {: RESULT = f; :}
    ;

Factor ::=
    NOT Factor:operand
    {: RESULT = new UnaryNode("NOT", operand); :}
    |
    LPAREN Exp:e RPAREN
    {: RESULT = e; :}
    |
    VARIABLE:v
    {: RESULT = new VariableNode(v); :}
    ;
