package grammar;

import java_cup.runtime.*;
import grammar.node.*;

parser code {:
    private Lexer lexer;

    public parser(Lexer lexer) {
        this();
        this.lexer = lexer;
    }

    @Override
    public void report_error(String message, Object info) {
        if (info instanceof Symbol) {
            Symbol s = (Symbol) info;
            System.err.println("Error sintactico en posicion " + s.left
                + ": token '" + s.value + "'");
        } else {
            System.err.println("Error sintactico: " + message);
        }
    }
:};

scan with {: return lexer.next_token(); :};

terminal String    AND, OR, NOT, LPAREN, RPAREN;
terminal String    VARIABLE;

nonterminal ParseNode    Exp, Term, Factor;

start with Exp;

Exp ::=
    Exp:left OR:op Term:right
    {: 
        ParseNode n = new ParseNode("Exp");
        n.add(left);
        n.add(new ParseNode("OR", op));
        n.add(right);
        RESULT = n;
    :}
    |
    Term:t
    {:
        ParseNode n = new ParseNode("Exp");
        n.add(t);
        RESULT = n;
    :}
    ;

Term ::=
    Term:left AND:op Factor:right
    {:
        ParseNode n = new ParseNode("Term");
        n.add(left);
        n.add(new ParseNode("AND", op));
        n.add(right);
        RESULT = n;
    :}
    |
    Factor:f
    {:
        ParseNode n = new ParseNode("Term");
        n.add(f);
        RESULT = n;
    :}
    ;

Factor ::=
    NOT:op Factor:operand
    {:
        ParseNode n = new ParseNode("Factor");
        n.add(new ParseNode("NOT", op));
        n.add(operand);
        RESULT = n;
    :}
    |
    LPAREN:lp Exp:e RPAREN:rp
    {:
        ParseNode n = new ParseNode("Factor");
        n.add(new ParseNode("LPAREN", lp));
        n.add(e);
        n.add(new ParseNode("RPAREN", rp));
        RESULT = n;
    :}
    |
    VARIABLE:v
    {:
        ParseNode n = new ParseNode("Factor");
        n.add(new ParseNode("VARIABLE", v));
        RESULT = n;
    :}
    ;
